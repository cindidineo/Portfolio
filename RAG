from sentence_transformers import SentenceTransformer
import faiss
import numpy as np

# 1. YOUR CV DOCUMENT - This is the "knowledge base" for RAG
cv_text = """
This document presents the comprehensive professional profile of Dineo Cindi, a skilled individual based in South Africa. 
It outlines an extensive educational background focused on information technology, including certifications in artificial intelligence, cloud computing, and cybersecurity. 
The text highlights practical experience as an IT Enabler, where the candidate managed technical support and administrative duties using Microsoft 365 tools. 
Furthermore, it lists technical proficiencies such as web development and data management alongside personal references to verify their professional standing. 

Most Recent Experience: Information Technology Enabler at Edunova (September 2025 – Present).
Duties: Provide first-line IT support, manage data entry and document formatting, train staff on digital tools.
Tech used: Microsoft 365 tools such as Excel, Word, and Outlook. Also practical experience using HTML and CSS to build a website.

Top 5 Technical Skills: Microsoft 365 Suite: Excel, Word, PowerPoint, and Outlook. Web Development: HTML and CSS. 
AI & Prompting: AI prompting and AI engineering basics. IT Support & Administration. Network Security.

Education: Grade 12 from Tsakane Ext 8 Secondary School. End User Computer NQF Level 3 from Uthando Community Development Centre.
Higher Education: University of Johannesburg - courses in 4IR in Artificial Intelligence, Financial Literacy, and Advanced Information Literacy.
Specialised Training: Educourse Academy: IT Security Administration, Business Administration, and AI engineering basics. Mlab: Cloud Computing.
Certifications: GEN AI (Wethinkcode), Linguistic AI training, Digital Learning, and certifications in Microsoft 365 (Excel and PowerPoint).

Qualified Web Development Internship Roles: Front-End Development Intern, Web Content Intern, Junior UI/UX or Web Support Intern.

Contact Information: Email: cindid ineo793@gmail.com. Phone: 0656729615. Address: 503 Mdhlela Street, Tsakane, 1550.
LinkedIn/GitHub: These profiles are not listed on the provided CV.
"""

# 2. CHUNK THE DOCUMENT
chunks = [p.strip() for p in cv_text.split('\n\n') if p.strip()]

# 3. CREATE EMBEDDINGS + VECTOR STORE
model = SentenceTransformer('all-MiniLM-L6-v2')
embeddings = model.encode(chunks)
dimension = embeddings.shape[1]
index = faiss.IndexFlatL2(dimension)
index.add(np.array(embeddings))

# 4. RAG CHAT FUNCTION
def rag_chat(question):
    # Retrieve most relevant chunk
    q_embedding = model.encode([question])
    D, I = index.search(np.array(q_embedding), k=1) # get top 1 chunk
    context = chunks[I[0][0]]
    
    # Simple "generation" - we just return the answer from the context
    # In a real RAG you'd send context+question to an LLM
    return f"Based on the CV:\n{context}"

# 5. TEST YOUR 5 QUESTIONS
questions = [
    "What are my top 5 technical skills and tools listed on my CV?",
    "Summarize my most recent project experience and what tech I used.",
    "What certifications or education do I have according to the CV?",
    "Based on my CV, what kind of web development internship roles am I qualified for?",
    "What is my contact info and LinkedIn/GitHub if listed?"
]

for q in questions:
    print(f"\nQ: {q}")
    print(f"A: {rag_chat(q)}")
    print("-"*50)
