<div class="container">
  <h2>Ask Neo Anything 📚</h2>
  <p>Stuck on Math, Science, History, or need help with an essay? Ask me!</p>
  
  <div class="chat-box" id="chatBox">
    <div class="msg neo">Hi! I'm Neo 👋 I'm here to help you with any subject, any grade. What do you want to learn today?</div>
  </div>

  <div class="input-area">
    <input type="text" id="userInput" placeholder="Ask: Explain photosynthesis for Grade 7...">
    <button onclick="sendMessage()">Send</button>
  </div>
</div>

<footer>
  <h3>Contact Neo Support</h3>
  <p>Email: <a href="mailto:cindidino793@mail.com" style="color:#fff;">cindidino793@mail.com</a></p>
