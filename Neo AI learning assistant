  <p>© 2026 Neo AI Assistant. Made for learners.</p>
</footer>

<script>
// Simple demo chat - Replace this with OpenAI API later
function sendMessage() {
  const input = document.getElementById("userInput");
  const chatBox = document.getElementById("chatBox");
  if (input.value.trim() === "") return;

  // Show user message
  chatBox.innerHTML += `<div class="msg user">${input.value}</div>`;
  
  // Neo reply - demo logic
  let reply = "That's a great question! ";
  if (input.value.toLowerCase().includes("math")) reply += "Let's solve it step by step. What grade are you in?";
  else if (input.value.toLowerCase().includes("english")) reply += "I can help with grammar, essays, and vocabulary. Check the 'English Levels' page too!";
  else reply += "I'm Neo and I can explain any topic simply. Can you tell me your grade and subject?";

  setTimeout(() => {
    chatBox.innerHTML += `<div class="msg neo">${reply}</div>`;
    chatBox.scrollTop = chatBox.scrollHeight;
  }, 600);

  input.value = "";
}
</script>

