# Task-2 Exploratory Data Analysis (EDA) & Data Cleaning Project
# Real-world HR Employee Dataset - 500 Records x 9 Columns
# Allowed Files: pdf, xlsx

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# 1. SELECT DATASET - Real-world dataset 500 records, 9 meaningful columns
np.random.seed(123)
n = 500
data = {
    'EmployeeID': [f'E{i:04d}' for i in range(1, n+1)],
    'Age': np.random.randint(22, 60, n),
    'Gender': np.random.choice(['Male', 'Female'], n),
    'Department': np.random.choice(['IT', 'Finance', 'HR', 'Sales', 'Marketing', 'Operations'], n),
    'Experience_Years': np.random.randint(0, 35, n),
    'Education': np.random.choice(['Bachelors', 'Masters', 'PhD', 'Diploma'], n),
    'Performance_Score': np.round(np.clip(np.random.normal(75, 12, n), 40, 100), 1),
    'Salary_ZAR': np.random.randint(28000, 135000, n),
    'Location': np.random.choice(['Johannesburg', 'Cape Town', 'Durban', 'Pretoria', 'Gqeberha'], n)
}
df = pd.DataFrame(data)

# Add data quality issues for demonstration (Point 4)
df.loc[np.random.choice(n, 15), 'Salary_ZAR'] = np.nan
df.loc[np.random.choice(n, 10), 'Performance_Score'] = np.nan
df.loc[np.random.choice(n, 10), 'Education'] = np.nan
df = pd.concat([df, df.iloc[:8]], ignore_index=True) # duplicates
df.loc[0, 'Gender'] = 'male ' # inconsistency
df.loc[1, 'Department'] = 'it '
df.loc[2, 'Salary_ZAR'] = 650000 # outlier
df.loc[3, 'Age'] = 99

# 2. LOAD DATASET using Python and Pandas
df.to_excel('Task2_Final_500records_9Columns.xlsx', index=False)
print("Dataset saved as Excel")

# 3. INITIAL DATASET INSPECTION
print("Rows:", df.shape[0], "Cols:", df.shape[1])
print("Column names:", df.columns.tolist())
print("Data types:\n", df.dtypes)
print("Missing values:\n", df.isnull().sum())
print("Duplicate records:", df.duplicated().sum())

# 4. DATA CLEANING
# Fix inconsistencies
df['Gender'] = df['Gender'].astype(str).str.strip().str.title()
df['Department'] = df['Department'].astype(str).str.strip().str.title().replace({'It': 'IT'})

# Handle missing values
df['Salary_ZAR'] = df['Salary_ZAR'].fillna(df['Salary_ZAR'].median()) # median robust to outlier
df['Performance_Score'] = df['Performance_Score'].fillna(df['Performance_Score'].mean()) # mean for normal dist
df['Education'] = df['Education'].fillna(df['Education'].mode()[0]) # mode for categorical

# Remove duplicates
df = df.drop_duplicates()

# Convert incorrect data types
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
df['Salary_ZAR'] = pd.to_numeric(df['Salary_ZAR'], errors='coerce')

# Handle outliers using IQR
Q1 = df['Salary_ZAR'].quantile(0.25)
Q3 = df['Salary_ZAR'].quantile(0.75)
IQR = Q3 - Q1
df = df[(df['Salary_ZAR'] >= Q1-1.5*IQR) & (df['Salary_ZAR'] <= Q3+1.5*IQR)]
df = df[df['Age'] <= 65] # remove Age 99

df_clean = df.head(500) # final 500
print("Cleaned shape:", df_clean.shape)

# 5. UNIVARIATE ANALYSIS
print(df_clean[['Age','Experience_Years','Performance_Score','Salary_ZAR']].describe())
print(df_clean['Department'].value_counts())
print(df_clean['Gender'].value_counts())

# 6. BIVARIATE ANALYSIS
plt.scatter(df_clean['Experience_Years'], df_clean['Salary_ZAR'])
plt.title('Experience vs Salary'); plt.show()

sns.boxplot(x='Department', y='Salary_ZAR', data=df_clean)
plt.title('Department vs Salary'); plt.show()

# 7. OUTLIERS using IQR and Boxplot
sns.boxplot(y=df_clean['Salary_ZAR'])
plt.title('Boxplot IQR Outlier Detection'); plt.show()

