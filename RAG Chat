import os
from dotenv import load_dotenv
from langchain_community.vectorstores import FAISS
from langchain_openai import OpenAIEmbeddings, ChatOpenAI
from langchain.chains import RetrievalQA
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain.schema import Document
from langchain.prompts import PromptTemplate

# 1. Load API Key
load_dotenv()
os.environ["OPENAI_API_KEY"] = os.getenv("OPENAI_API_KEY") # put key in .env file

# 2. Your CV Data as Documents
cv_text = """
DINEO CINDI - PROFESSIONAL SUMMARY

5 Technical Skills and Tools:
1. Microsoft 365 Suite: Excel, Word, PowerPoint, and Outlook
2. Web Development: Proficiency in HTML and CSS
3. AI & Prompting: Skills in AI prompting and AI engineering basics
4. IT Support & Administration: Experience with first-line IT support and technical documentation
5. Network Security: Listed as a key skill, complemented by IT Security Administration training

Most Recent Experience:
Information Technology Enabler at Edunova (September 2025 – Present)
- Provide first-line IT support and maintain files
- Manage data entry and document formatting  
- Train staff on digital tools to improve efficiency
Tech used: Microsoft 365 tools such as Excel, Word, and Outlook
Practical experience using HTML and CSS to build a website

Education and Certifications:
- Grade 12 from Tsakane Ext 8 Secondary School
- End User Computer NQF Level 3 from Uthando Community Development Centre
- University of Johannesburg: 4IR in Artificial Intelligence, Financial Literacy, Advanced Information Literacy
- Educourse Academy: IT Security Administration, Business Administration, AI engineering basics
- Mlab: Cloud Computing
- Certifications: GEN AI (Wethinkcode), Linguistic AI training, Digital Learning, Microsoft 365 (Excel and PowerPoint)

Qualified Web Development Internship Roles:
- Front-End Development Intern: HTML and CSS website experience
- Web Content Intern: Content creation and web technologies
- Junior UI/UX or Web Support Intern: IT support + web development knowledge

Contact Information:
Email: cindidineo793@gmail.com
Phone: 0656729615
Address: 503 Mdhlela Street, Tsakane, 1550
LinkedIn/GitHub: Not listed on CV
"""

# 3. Split into chunks
splitter = RecursiveCharacterTextSplitter(chunk_size=500, chunk_overlap=100)
docs = splitter.split_documents([Document(page_content=cv_text)])

# 4. Create Vector Store
embeddings = OpenAIEmbeddings()
vectorstore = FAISS.from_documents(docs, embeddings)

# 5. RAG Chain with anti-hallucination prompt
prompt_template = """
You are answering questions about Dineo Cindi based ONLY on her CV provided below.
If the information is not in the CV, say "That information is not in the CV."
Be factual and specific.

CV Context: {context}
Question: {question}
Answer:
"""
PROMPT = PromptTemplate(template=prompt_template, input_variables=["context", "question"])

llm = ChatOpenAI(model="gpt-4o-mini", temperature=0)
qa = RetrievalQA.from_chain_type(
    llm=llm,
    retriever=vectorstore.as_retriever(search_kwargs={"k": 2}),
    chain_type_kwargs={"prompt": PROMPT}
)

print("✅ Chat with Dineo Cindi's CV is Ready!\n")

# 6. Auto-run the 5 Demo Questions
demo_questions = [
    "What are Dineo Cindi's top 5 technical skills and tools?",
    "What is Dineo's most recent job experience and what technology was used?",
    "What education and certifications does Dineo have?",
    "What kind of web development internship roles is Dineo qualified for?",
    "What is Dineo's contact information?"
]

for i, q in enumerate(demo_questions, 1):
    print(f"\n--- Q{i}: {q} ---")
    print("A:", qa.invoke({"query": q})['result'])

# 7. Interactive Chat for Demo Video
while True:
    user_q = input("\nAsk anything about Dineo's CV [type 'exit']: ")
    if user_q.lower() == 'exit':
        break
    print("A:", qa.invoke({"query": user_q})['result'])
