import os
from dotenv import load_dotenv
from langchain_community.document_loaders import PyPDFLoader
from langchain_community.vectorstores import FAISS
from langchain_openai import OpenAIEmbeddings, ChatOpenAI
from langchain.chains import RetrievalQA
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain.prompts import PromptTemplate

# 1. Load API Key
load_dotenv()
os.environ["OPENAI_API_KEY"] = os.getenv("OPENAI_API_KEY") # put key in.env file

PDF_PATH = "/mnt/data/CV.pdf"

print("Loading Dineo Cindi's CV...")

# 2. Load PDF
loader = PyPDFLoader(PDF_PATH)
documents = loader.load()

# 3. Chunk the document
text_splitter = RecursiveCharacterTextSplitter(
    chunk_size=800,
    chunk_overlap=150
)
chunks = text_splitter.split_documents(documents)

# 4. Create Embeddings + FAISS Vector Store
embeddings = OpenAIEmbeddings()
vectorstore = FAISS.from_documents(chunks, embeddings)

# 5. Create LLM + RAG Chain with custom prompt to avoid hallucinations
prompt_template = """
You are an assistant that answers questions ONLY using the provided CV context.
If the answer is not in the context, say "I cannot find that information in the CV."
Context: {context}
Question: {question}
Answer:
"""

PROMPT = PromptTemplate(template=prompt_template, input_variables=["context", "question"])

llm = ChatOpenAI(model="gpt-4o-mini", temperature=0)

qa_chain = RetrievalQA.from_chain_type(
    llm=llm,
    chain_type="stuff",
    retriever=vectorstore.as_retriever(search_kwargs={"k": 4}),
    chain_type_kwargs={"prompt": PROMPT},
    return_source_documents=True
)

print("✅ RAG Ready! Ask questions about Dineo Cindi's profile\n")

# 6. The 5 Demo Questions for your video
demo_questions = [
    "What are Dineo Cindi's top 5 technical skills and tools?",
    "Summarize Dineo's education and certifications in AI, Cloud, and Cybersecurity.",
    "What was Dineo's role as an IT Enabler and what tools were used?",
    "Based on this CV, what kind of web development or IT roles is Dineo qualified for?",
    "What personal references are listed in the CV?"
]

for i, q in enumerate(demo_questions, 1):
    print(f"\n--- Question {i}: {q} ---")
    result = qa_chain.invoke({"query": q})
    print(f"Answer: {result['result']}")

# 7. Interactive Chat Loop for Demo Video
print("\n--- Interactive Mode ---")
while True:
    user_q = input("\nAsk anything about Dineo's CV [type 'exit' to quit]: ")
    if user_q.lower() == 'exit':
        break
    result = qa_chain.invoke({"query": user_q})
    print("Answer:", result['result'])
    print("Source snippet:", result['source_documents'][0].page_content[:150], "...")
