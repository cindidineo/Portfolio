
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neo — AI Learning Assistant</title>
  <style>
    :root {
      --bg: #0f172a
;
      --bg2: #111827
;
      --card: rgba(255, 255, 255, 0.08);
      --card-strong: rgba(255, 255, 255, 0.12);
      --text: #f8fafc
;
      --muted: #cbd5e1
;
      --accent: #7c3aed
;
      --accent2: #2563eb
;
      --accent3: #22c55e
;
      --border: rgba(255, 255, 255, 0.12);
      --shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      --radius: 20px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background:
        radial-gradient(circle at top left, rgba(124, 58, 237, 0.35), transparent 28%),
        radial-gradient(circle at top right, rgba(37, 99, 235, 0.25), transparent 24%),
        linear-gradient(180deg, #020617
 0%, #0f172a
 35%, #111827
 100%);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(2, 6, 23, 0.65);
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      letter-spacing: 0.2px;
    }

    .logo {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      box-shadow: var(--shadow);
      font-size: 1.2rem;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .nav-links a {
      color: var(--muted);
      font-weight: 600;
      font-size: 0.95rem;
      transition: 0.2s ease;
    }

    .nav-links a:hover {
      color: #fff;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: 0;
      border-radius: 999px;
      padding: 13px 18px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
      white-space: nowrap;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: white;
      box-shadow: 0 10px 30px rgba(124, 58, 237, 0.35);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: white;
      border: 1px solid var(--border);
    }

    .hero {
      padding: 64px 0 30px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 24px;
      align-items: stretch;
    }

    .hero-copy,
    .hero-panel,
    .section-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .hero-copy {
      padding: 36px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      color: #e2e8f0
;
      font-size: 0.92rem;
      font-weight: 700;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.3rem, 5vw, 4.8rem);
      line-height: 1.02;
      letter-spacing: -0.04em;
      margin-bottom: 18px;
    }

    .hero-copy p {
      color: var(--muted);
      font-size: 1.05rem;
      max-width: 60ch;
      margin-bottom: 24px;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 28px;
    }

    .trust-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .trust-pill {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      color: #e2e8f0
;
      padding: 10px 14px;
      border-radius: 999px;
      font-size: 0.92rem;
      font-weight: 600;
    }

    .hero-panel {
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .panel-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .mini-badge {
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(34, 197, 94, 0.12);
      color: #86efac
;
      border: 1px solid rgba(34, 197, 94, 0.2);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .level-selector,
    .subject-selector,
    .tool-grid {
      display: grid;
      gap: 10px;
    }

    .selector-title {
      font-weight: 700;
      color: #fff;
      font-size: 0.96rem;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .chip {
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.06);
      color: #e2e8f0
;
      padding: 10px 14px;
      border-radius: 999px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: 0.2s ease;
      user-select: none;
    }

    .chip:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .chip.active {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: white;
      border-color: transparent;
    }

    .section {
      padding: 24px 0;
    }

    .section-card {
      padding: 28px;
    }

    .section-title {
      font-size: clamp(1.4rem, 2.5vw, 2rem);
      margin-bottom: 10px;
      letter-spacing: -0.03em;
    }

    .section-subtitle {
      color: var(--muted);
      margin-bottom: 20px;
      max-width: 70ch;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }

    .card {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
    }

    .card h3 {
      margin-bottom: 8px;
      font-size: 1.05rem;
    }

    .card p,
    .card li {
      color: var(--muted);
      font-size: 0.96rem;
    }

    .step-num {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      margin-bottom: 12px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      font-weight: 800;
    }

    .study-tools {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tool {
      padding: 12px 14px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      font-weight: 600;
      color: #e2e8f0
;
    }

    .chat-shell {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .chat-box {
      height: 380px;
      overflow-y: auto;
      background: rgba(2, 6, 23, 0.55);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .msg {
      max-width: 82%;
      padding: 12px 14px;
      border-radius: 16px;
      font-size: 0.96rem;
      line-height: 1.5;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .msg.user {
      align-self: flex-end;
      background: linear-gradient(135deg, var(--accent2), var(--accent));
      color: white;
      border-bottom-right-radius: 6px;
    }

    .msg.neo {
      align-self: flex-start;
      background: rgba(255, 255, 255, 0.08);
      color: #f8fafc
;
      border: 1px solid var(--border);
      border-bottom-left-radius: 6px;
    }

    .chat-controls {
      display: grid;
      gap: 12px;
    }

    .input-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    input, select, textarea {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px 15px;
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
      outline: none;
      font-size: 1rem;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    input::placeholder,
    textarea::placeholder {
      color: #94a3b8
;
    }

    select option {
      color: #0f172a
;
    }

    .input-grow {
      flex: 1 1 260px;
    }

    .small-note {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .levels-list {
      display: grid;
      gap: 14px;
    }

    .level-item {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      padding: 18px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
    }

    .level-item strong {
      display: block;
      margin-bottom: 4px;
    }

    .faq {
      display: grid;
      gap: 12px;
    }

    .faq-item {
      padding: 18px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.06);
    }

    .faq-item h3 {
      margin-bottom: 8px;
    }

    .footer {
      padding: 30px 0 44px;
      color: var(--muted);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      border-top: 1px solid var(--border);
      padding-top: 22px;
    }

    .footer-links {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: #e2e8f0
;
    }

    .hidden {
      display: none !important;
    }

    @media (max-width: 980px) {
      .hero-grid,
      .grid-4,
      .grid-3,
      .grid-2 {
        grid-template-columns: 1fr;
      }

      .nav-inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .level-item {
        flex-direction: column;
      }
    }

    @media (max-width: 640px) {
      .hero {
        padding-top: 34px;
      }

      .hero-copy,
      .section-card {
        padding: 20px;
      }

      .chat-box {
        height: 320px;
      }

      .msg {
        max-width: 92%;
      }
    }
  </style>
</head>
<body>
  <header class="nav">
    <div class="container nav-inner">
      <a class="brand" href="#home">
        <div class="logo">N</div>
        <div>
          <div>Neo</div>
