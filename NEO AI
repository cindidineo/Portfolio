            <button class="chip" data-subject="History">History</button>
            <button class="chip" data-subject="Business">Business</button>
          </div>
        </div>

        <div class="tool-grid">
          <div class="selector-title">What Neo can do</div>
          <div class="study-tools">
            <div class="tool">Explain simply</div>
            <div class="tool">Summarize notes</div>
            <div class="tool">Make a quiz</div>
            <div class="tool">Help with essays</div>
            <div class="tool">Step-by-step solving</div>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <section id="chat" class="section">
    <div class="container section-card">
      <h2 class="section-title">Ask Neo Anything</h2>
      <p class="section-subtitle">
        Type a question, choose a level and subject, and Neo will answer in a way that matches the learner.
      </p>

      <div class="chat-shell">
        <div class="chat-box" id="chatBox" aria-live="polite">
