  <script>
    const state = {
      level: "Primary school",
      subject: "English"
    };

    function addMessage(text, sender) {
      const chatBox = document.getElementById("chatBox");
      const msg = document.createElement("div");
      msg.className = `msg ${sender}`;
      msg.textContent = text;
      chatBox.appendChild(msg);
      chatBox.scrollTop = chatBox.scrollHeight;
    }

    function setActiveChip(groupId, value) {
      const buttons = document.querySelectorAll(`#${groupId} .chip`);
      buttons.forEach(btn => {
        btn.classList.toggle("active", btn.dataset[groupId === "levelChips" ? "level" : "subject"] === value);
      });
    }

    document.querySelectorAll("#levelChips .chip").forEach(btn => {
      btn.addEventListener("click", () => {
        state.level = btn.dataset.level;
        setActiveChip("levelChips", state.level);
      });
    });

    document.querySelectorAll("#subjectChips .chip").forEach(btn => {
      btn.addEventListener("click", () => {
        state.subject = btn.dataset.subject;
        setActiveChip("subjectChips", state.subject);
      });
    });

    function getNeoReply(question) {
      const q = question.toLowerCase();

      const levelHint = {
        "Primary school": "I'll explain it in very simple words with an easy example.",
        "High school": "I'll explain it clearly and add useful detail for school work.",
        "University": "I'll give a more advanced, academic explanation.",
        "Adult learner": "I'll keep it practical, clear, and easy to apply."
      }[state.level] || "I'll explain it clearly.";

      const subjectHint = {
        "English": "I can help with grammar, reading, writing, vocabulary, and essays.",
        "Math": "I can help solve problems step by step and explain formulas.",
        "Science": "I can explain scientific ideas, experiments, and concepts.",
        "History": "I can help you understand events, timelines, and causes.",
        "Business": "I can help with business concepts, marketing, accounting, and strategy."
      }[state.subject] || "I can help with your subject.";

      if (q.includes("essay")) {
        return `${levelHint}\n\nFor ${state.subject}, I can help you with essay structure, ideas, and improving your answer.`;
      }

      if (q.includes("summary") || q.includes("summarize") || q.includes("summarise")) {
        return `${levelHint}\n\nI can summarize your notes into shorter study points. Send me the text and I'll make it easier to revise.`;
      }

      if (q.includes("quiz") || q.includes("test me")) {
        return `${levelHint}\n\nI can make a short quiz on ${state.subject}. Send me the topic and I'll generate practice questions.`;
      }

      if (q.includes("math") || q.includes("+") || q.includes("-") || q.includes("÷") || q.includes("/") || q.includes("*")) {
        return `${levelHint}\n\n${subjectHint} If you share the exact question, I'll solve it step by step.`;
      }

      if (q.includes("english") || q.includes("grammar") || q.includes("vocabulary") || q.includes("write")) {
        return `${levelHint}\n\n${subjectHint} If you want, I can correct your writing, explain grammar, or help build stronger vocabulary.`;
      }

      return `${levelHint}\n\n${subjectHint} Ask me the topic, and I'll explain it in a way that matches your level.`;
    }

    function sendMessage() {
      const input = document.getElementById("userInput");
      const value = input.value.trim();
      if (!value) return;

      addMessage(value, "user");

      const reply = getNeoReply(value);

      setTimeout(() => {
        addMessage(reply, "neo");
      }, 500);

      input.value = "";
    }

    document.getElementById("userInput").addEventListener("keydown", (e) => {
      if (e.key === "Enter") sendMessage();
    });
  </script>
</body>
</html>
