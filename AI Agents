<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NeuroFive: 2-Agent AI Orchestration</title>
<style>
    :root {
        --bg: #000000;
        --card: #0a0a0a;
        --border: #00ff41;
        --text: #e0ffe0;
        --green: #00ff41;
        --green-dim: #00cc33;
        --writer: #00ff41;
        --editor: #39ff14;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Consolas', 'Courier New', monospace; }
    body { background: var(--bg); color: var(--text); padding: 20px; }
    .container { max-width: 1100px; margin: auto; }
    h1 { color: var(--green); text-align: center; margin-bottom: 10px; text-shadow: 0 0 10px var(--green); }
    .subtitle { text-align: center; color: var(--green-dim); margin-bottom: 30px; }
    
    .settings { background: var(--card); border: 1px solid var(--border); padding: 20px; border-radius: 8px; margin-bottom: 20px; box-shadow: 0 0 15px rgba(0,255,65,0.1); }
    .settings input, .settings select { width: 100%; padding: 10px; background: #111; border: 1px solid var(--border); color: var(--text); border-radius: 4px; margin-top: 5px; }
    
    .pipeline { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    .agent-card { background: var(--card); border: 1px solid var(--border); padding: 20px; border-radius: 8px; min-height: 400px; box-shadow: 0 0 15px rgba(0,255,65,0.1); }
    .agent-header { display: flex; align-items: center; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px dashed var(--border); }
    .agent-icon { width: 12px; height: 12px; border-radius: 50%; margin-right: 10px; box-shadow: 0 0 8px currentColor; }
    .writer .agent-icon { background: var(--writer); }
    .editor .agent-icon { background: var(--editor); }
    .agent-title { color: var(--green); font-size: 18px; font-weight: bold; }
    .agent-role { font-size: 12px; color: var(--green-dim); }
    
    textarea { width: 100%; height: 250px; background: #050505; color: var(--text); border: 1px solid var(--border); border-radius: 4px; padding: 10px; resize: vertical; font-size: 14px; }
    
    .controls { text-align: center; margin: 30px 0; }
    button { background: var(--green); color: #000; border: none; padding: 14px 28px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 16px; transition: 0.2s; box-shadow: 0 0 15px var(--green); }
    button:hover { background: var(--green-dim); transform: scale(1.05); }
    button:disabled { background: #333; color: #666; cursor: not-allowed; box-shadow: none; }
    
    .comparison { background: var(--card); border: 1px solid var(--border); padding: 20px; border-radius: 8px; margin-top: 20px; }
    .diff { background: #001100; padding: 10px; border-left: 3px solid var(--green); margin-top: 10px; }
    .log { font-size: 12px; color: var(--green-dim); margin-top: 10px; }
    .loading { animation: blink 1s infinite; }
    @keyframes blink { 50% { opacity: 0.5; }
</style>
</head>
<body>
<div class="container">
    <h1>> 2-AGENT ORCHESTRATION SYSTEM</h1>
    <p class="subtitle">Agent 1: Writer drafts | Agent 2: Editor refines | Real API calls</p>

    <!-- API SETTINGS -->
    <div class="settings">
        <h3 style="color: var(--green); margin-bottom: 10px;">API Configuration</h3>
        <label>API Key:</label>
        <input type="password" id="apiKey" placeholder="sk-... or your Grok/Gemini key">
        
        <label style="margin-top:10px;">API Endpoint:</label>
        <select id="apiEndpoint">
            <option value="https://api.openai.com/v1/chat/completions">OpenAI GPT-4o / GPT-5</option>
            <option value="https://api.x.ai/v1/chat/completions">Grok 4</option>
            <option value="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions">Google Gemini</option>
        </select>
        
        <label style="margin-top:10px;">Topic to Test:</label>
        <input type="text" id="topic" value="Benefits of using AI agents in small businesses in South Africa">
    </div>

    <!-- AGENTS -->
    <div class="pipeline">
        <div class="agent-card writer">
            <div class="agent-header">
                <div class="agent-icon"></div>
                <div>
                    <div class="agent-title">AGENT 1: WRITER</div>
                    <div class="agent-role">Role: Draft content, be creative and fast</div>
                </div>
            </div>
            <textarea id="writerOutput" readonly placeholder="Writer output will appear here..."></textarea>
            <div class="log" id="writerLog"></div>
        </div>

        <div class="agent-card editor">
            <div class="agent-header">
                <div class="agent-icon"></div>
                <div>
                    <div class="agent-title">AGENT 2: EDITOR/CRITIC</div>
                    <div class="agent-role">Role: Review, fact-check, improve clarity</div>
                </div>
            </div>
            <textarea id="editorOutput" readonly placeholder="Editor output will appear here..."></textarea>
            <div class="log" id="editorLog"></div>
        </div>
    </div>

    <!-- CONTROLS -->
    <div class="controls">
        <button id="runBtn" onclick="runPipeline()">RUN 2-AGENT PIPELINE</button>
    </div>

    <!-- COMPARISON -->
    <div class="comparison">
        <h3 style="color: var(--green);">What Did The Editor Improve?</h3>
        <div class="diff" id="improvements">Run the pipeline to see improvements...</div>
    </div>
</div>

<script>
const SYSTEM_PROMPT_WRITER = `You are AGENT 1: THE WRITER.
Your job: Draft clear, engaging content on the given topic.
Be creative, use examples, write 3-4 paragraphs.
Do not edit yourself. Just output the draft.`;

const SYSTEM_PROMPT_EDITOR = `You are AGENT 2: THE EDITOR/CRITIC.
Your job: Review the draft from Agent 1 and improve it.
Tasks: 1. Fix grammar and clarity 2. Add structure with headings 
3. Remove fluff 4. Make it more professional and actionable.
Output ONLY the improved final version. Do not explain your changes.`;

async function callAI(systemPrompt, userMessage) {
    const apiKey = document.getElementById('apiKey').value;
    const endpoint = document.getElementById('apiEndpoint').value;
    
    if(!apiKey) throw new Error("Please enter your API Key");

    const body = {
        model: "gpt-4o", // works for OpenAI. For Grok use "grok-4", for Gemini use "gemini-2.0-flash"
        messages: [
            { role: "system", content: systemPrompt },
            { role: "user", content: userMessage }
        ],
        temperature: 0.7
    };

    const res = await fetch(endpoint, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${apiKey}`
        },
        body: JSON.stringify(body)
    });

    if(!res.ok) throw new Error(await res.text());
    const data = await res.json();
    return data.choices[0].message.content;
}

function getImprovements(draft, final) {
    // Simple diff logic
    let improvements = [];
    if(final.length > draft.length) improvements.push("Added more detail and structure");
    if(final.includes("#") || final.includes("**")) improvements.push("Added headings and formatting");
    if(final.split('.').length > draft.split('.').length) improvements.push("Improved clarity and flow");
    improvements.push("Removed filler words and made tone more professional");
    return improvements.map(i => `• ${i}`).join('\n');
}

async function runPipeline() {
    const btn = document.getElementById('runBtn');
    const topic = document.getElementById('topic').value;
    btn.disabled = true;
    btn.innerText = "RUNNING...";

    try {
        // AGENT 1: WRITER
        document.getElementById('writerLog').innerText = "Calling Writer API...";
        document.getElementById('writerOutput').value = "Generating draft...";
        const draft = await callAI(SYSTEM_PROMPT_WRITER, `Write about: ${topic}`);
        document.getElementById('writerOutput').value = draft;
        document.getElementById('writerLog').innerText = "Draft complete. Sending to Editor...";

        await new Promise(r => setTimeout(r, 800)); // small delay for effect

        // AGENT 2: EDITOR
        document.getElementById('editorLog').innerText = "Calling Editor API...";
        document.getElementById('editorOutput').value = "Refining draft...";
        const final = await callAI(SYSTEM_PROMPT_EDITOR, `Here is the draft to improve:\n\n${draft}`);
        document.getElementById('editorOutput').value = final;
        document.getElementById('editorLog').innerText = "Refinement complete.";

        // SHOW IMPROVEMENTS
        document.getElementById('improvements').innerText = getImprovements(draft, final);

    } catch (err) {
        alert("Error: " + err.message);
        document.getElementById('writerLog').innerText = "Error";
        document.getElementById('editorLog').innerText = "Error";
    }

    btn.disabled = false;
    btn.innerText = "RUN 2-AGENT PIPELINE";
}
</script>
</body>
</html>
