<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>TaskHub - Mini SaaS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
</head>
<body class="bg-gray-50 text-gray-800">
  <div id="app" class="min-h-screen flex-col">
    <!-- NAV -->
    <nav class="bg-white shadow p-4 flex justify-between items-center">
      <h1 class="font-bold text-xl text-indigo-600">TaskHub</h1>
      <div id="nav-links" class="space-x-4 hidden">
        <button onclick="showPage('dashboard')" class="hover:text-indigo-600">Dashboard</button>
        <button onclick="showPage('tasks')" class="hover:text-indigo-600">Tasks</button>
        <button onclick="showPage('profile')" class="hover:text-indigo-600">Profile</button>
        <button id="admin-link" onclick="showPage('admin')" class="hover:text-indigo-600 hidden">Admin</button>
        <button onclick="logout()" class="text-red-500">Logout</button>
      </div>
    </nav>

    <!-- AUTH PAGE -->
    <div id="auth-page" class="flex-1 flex items-center justify-center p-4">
      <div class="bg-white p-8 rounded-lg shadow w-full max-w-md">
        <h2 class="text-2xl font-bold mb-4 text-center">Login / Register</h2>
        <input id="email" type="email" placeholder="Email" class="w-full border p-2 rounded mb-3"/>
        <input id="password" type="password" placeholder="Password" class="w-full border p-2 rounded mb-3"/>
        <select id="role" class="w-full border p-2 rounded mb-3">
          <option value="user">User</option>
          <option value="admin">Admin</option>
        </select>
        <button onclick="register()" class="w-full bg-indigo-600 text-white p-2 rounded mb-2">Register</button>
        <button onclick="login()" class="w-full bg-gray-200 p-2 rounded">Login</button>
        <p id="auth-error" class="text-red-500 mt-2 text-sm"></p>
      </div>
    </div>

    <!-- DASHBOARD -->
    <div id="dashboard-page" class="p-6 hidden">
      <h2 class="text-3xl font-bold mb-4">Dashboard</h2>
      <p>Welcome back, <span id="user-email"></span>! Role: <span id="user-role" class="font-semibold"></span></p>
      <div id="notifications" class="mt-4 p-4 bg-yellow-100 rounded hidden"></div>
    </div>

    <!-- TASKS -->
    <div id="tasks-page" class="p-6 hidden">
      <h2 class="text-3xl font-bold mb-4">Tasks</h2>
      <div class="flex gap-2 mb-4">
        <input id="task-title" placeholder="New task title" class="border p-2 rounded flex-1"/>
        <button onclick="createTask()" class="bg-indigo-600 text-white px-4 rounded">Add</button>
      </div>
      <ul id="task-list" class="space-y-2"></ul>
    </div>

    <!-- PROFILE -->
    <div id="profile-page" class="p-6 hidden">
      <h2 class="text-3xl font-bold mb-4">Profile</h2>
      <p><b>Email:</b> <span id="profile-email"></span></p>
      <p><b>Role:</b> <span id="profile-role"></span></p>
    </div>

    <!-- ADMIN -->
    <div id="admin-page" class="p-6 hidden">
      <h2 class="text-3xl font-bold mb-4">Admin Panel</h2>
      <button onclick="loadUsers()" class="bg-indigo-600 text-white px-4 py-2 rounded mb-4">Load All Users</button>
      <table class="w-full bg-white rounded shadow">
        <thead><tr class="bg-gray-100"><th class="p-2 text-left">ID</th><th class="p-2 text-left">Email</th><th class="p-2 text-left">Role</th></tr></thead>
        <tbody id="users-table"></tbody>
      </table>
    </div>
  </div>

<script>
const API_URL = "http://localhost:4000"; // Change to your Render URL
let token = localStorage.getItem("token");
let user = JSON.parse(localStorage.getItem("user"));
let socket;

// PAGES
function showPage(id) {
  document.querySelectorAll("#dashboard-page, #tasks-page, #profile-page, #admin-page").forEach(p => p.classList.add("hidden"));
  document.getElementById(id + "-page").classList.remove("hidden");
}

// AUTH
async function register() {
  const res = await fetch(`${API_URL}/api/register`, {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({
      email: email.value,
      password: password.value,
      role: role.value
    })
  });
  handleAuth(res);
}

async function login() {
  const res = await fetch(`${API_URL}/api/login`, {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({ email: email.value, password: password.value })
  });
  handleAuth(res);
}

async function handleAuth(res) {
  if(!res.ok) return auth-error.innerText = "Auth failed";
  const data = await res.json();
  token = data.token;
  user = JSON.parse(atob(token.split('.')[1])); // decode JWT
  localStorage.setItem("token", token);
  localStorage.setItem("user", JSON.stringify(user));
  initApp();
}

function logout() {
  localStorage.clear();
  location.reload();
}

// APP INIT
function initApp() {
  document.getElementById("auth-page").classList.add("hidden");
  document.getElementById("nav-links").classList.remove("hidden");
  user-email.innerText = user.email || "Demo";
  user-role.innerText = user.role;
  profile-email.innerText = user.email;
  profile-role.innerText = user.role;
  if(user.role === "admin") admin-link.classList.remove("hidden");
  showPage("dashboard");
  connectSocket();
  loadTasks();
}

// REAL-TIME
function connectSocket() {
  socket = io(API_URL);
  socket.on("task_created", (task) => {
    notifications.classList.remove("hidden");
    notifications.innerText = `New Task: ${task.title}`;
    setTimeout(() => notifications.classList.add("hidden"), 3000);
    loadTasks();
  });
}

// TASKS
async function loadTasks() {
  const res = await fetch(`${API_URL}/api/tasks`, { headers: {Authorization: `Bearer ${token}`} });
  const tasks = await res.json();
  task-list.innerHTML = tasks.map(t => `<li class="p-2 bg-white rounded shadow">${t.title}</li>`).join("");
}

async function createTask() {
  await fetch(`${API_URL}/api/tasks`, {
    method: "POST",
    headers: {"Content-Type": "application/json", Authorization: `Bearer ${token}`},
    body: JSON.stringify({ title: task-title.value })
  });
  task-title.value = "";
}

// ADMIN
async function loadUsers() {
  const res = await fetch(`${API_URL}/api/admin/users`, { headers: {Authorization: `Bearer ${token}`} });
  const users = await res.json();
  users-table.innerHTML = users.map(u => `<tr><td class="p-2">${u.id}</td><td class="p-2">${u.email}</td><td class="p-2">${u.role}</td></tr>`).join("");
}

// CHECK LOGIN ON LOAD
if(token) initApp();
</script>
</body>
</html>
