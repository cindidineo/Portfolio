'use client'
import { useState } from 'react'
import { supabase } from '@/lib/supabase'
import { useRouter } from 'next/navigation'

export default function AuthPage() {
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const router = useRouter()

  const signUp = async () => {
    const { data } = await supabase.auth.signUp({ email, password })
    if(data.user) await supabase.from('profiles').insert({id: data.user.id, email, role:'user'})
  }
  const login = async () => {
    await supabase.auth.signInWithPassword({ email, password })
    router.push('/dashboard')
  }

  return (
    <div style={{padding:40, maxWidth:400, margin:'auto'}}>
      <h1 style={{color:'#FF3131'}}>NEXORA TASKS PRO</h1>
      <input placeholder="Email" onChange={e=>setEmail(e.target.value)} style={input}/>
      <input placeholder="Password" type="password" onChange={e=>setPassword(e.target.value)} style={input}/>
      <button onClick={login} style={btn}>Login</button>
      <button onClick={signUp} style={{...btn, background:'#333'}}>Sign Up</button>
    </div>
  )
}
const input = {width:'100%', padding:12, margin:'8px 0', borderRadius:8, background:'#111', color:'#fff', border:'1px solid #222'}
const btn = {width:'100%', padding:12, background:'#FF3131', color:'#fff', border:'none', borderRadius:8, fontWeight:'bold'}
'use client'
import { useEffect, useState } from 'react'
import { supabase } from '@/lib/supabase'
import Link from 'next/link'

export default function Dashboard() {
  const [tasks, setTasks] = useState([])
  const [user, setUser] = useState(null)
  const [title, setTitle] = useState('')

  useEffect(() => {
    supabase.auth.getUser().then(({data}) => setUser(data.user))
    fetchTasks()
    const channel = supabase.channel('tasks')
     .on('postgres_changes', {event:'*', schema:'public', table:'tasks'}, fetchTasks)
     .subscribe()
    return () => supabase.removeChannel(channel)
  }, [user])

  const fetchTasks = async () => {
    const { data } = await supabase.from('tasks').select('*').eq('user_id', user?.id)
    setTasks(data || [])
  }
  const addTask = async () => {
    await supabase.from('tasks').insert({title, user_id:user.id})
    await supabase.from('notifications').insert({user_id:user.id, message:`New task: ${title}`})
    setTitle('')
  }

  return (
    <div style={{padding:20}}>
      <nav style={{display:'flex', gap:16, marginBottom:20}}>
        <Link href="/dashboard">Dashboard</Link>
        <Link href="/notifications">Notifications</Link>
        <Link href="/admin">Admin</Link>
      </nav>
      <h2>Your Tasks - LIVE</h2>
      <input value={title} onChange={e=>setTitle(e.target.value)} placeholder="New Task" style={input}/>
      <button onClick={addTask} style={btn}>Add</button>
      {tasks.map(t => <div key={t.id} style={card}>{t.title} - {t.status}</div>)}
    </div>
  )
}
const input = {padding:10, marginRight:8, background:'#111', color:'#fff', border:'1px solid #222'}
const btn = {padding:10, background:'#FF3131', color:'#fff', border:'none', borderRadius:8}
const card = {background:'#111', padding:12, margin:'8px 0', borderRadius:8}
# Nexora Tasks Pro
Mini full-stack platform with Auth, Roles, Realtime, Admin

## Architecture
Frontend: Next.js 14 App Router
Backend + DB + Auth + Realtime: Supabase
Hosting + CI/CD: Vercel + GitHub

## Features
- Auth: Email/Password with Supabase Auth
- Roles: user, manager, admin. RLS enforces access
- Realtime: Tasks and Notifications update live
- Admin Panel: Protected route. 2 metrics + user role management
- 3 User Pages: Auth, Dashboard, Notifications + 1 Admin page

## Run Locally
1. `npm install`
2. Create `.env.local` with Supabase keys
3. Run SQL in Supabase
4. `npm run dev`

## Deploy
Push to main branch → Auto deploy on Vercel
