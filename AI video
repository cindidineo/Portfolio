def load_font(size=36):
    # Try common TTF fonts; fallback to default if unavailable
    possible = [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
    ]
    for p in possible:
        if os.path.exists(p):
            return ImageFont.truetype(p, size=size)
    return ImageFont.load_default()

def create_text_frame(text, duration, bg_color=(0,30,60), size=(1280,720), padding=60):
    width, height = size
    img = Image.new('RGB', size, bg_color)
    draw = ImageDraw.Draw(img)
    font = load_font(size=40)
    max_width = width - padding*2
    # wrap text to fit width
    lines = []
    for paragraph in text.strip().split("\n"):
        wrapped = textwrap.wrap(paragraph, width=40)  # tweak width as needed
        if not wrapped:
            lines.append("")
        else:
            lines.extend(wrapped)
    # compute y start to vertically center
    line_height = font.getsize("Ay")[1] + 8
    total_h = line_height * len(lines)
    y = max((height - total_h) // 2, padding)
    for line in lines:
        w, h = draw.textsize(line, font=font)
        x = (width - w) // 2
        draw.text((x, y), line, fill=(255,255,255), font=font)
        y += line_height
    tmpname = f"temp_{uuid.uuid4().hex}.png"
    img.save(tmpname)
    clip = ImageClip(tmpname).set_duration(duration).resize(size)
    clip._tempfile = tmpname  # store for cleanup
    return clip

# Try to create clips from uploaded images pic1.jpg..pic5.jpg; if missing, create text frames from scenes
