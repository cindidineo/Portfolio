def create_text_frame(text, duration, bg_color=(0,30,60)):
    img = Image.new('RGB', (1280,720), bg_color)
    draw = ImageDraw.Draw(img)
    # Add text wrapped
    draw.text((100,300), text, fill=(255,255,255), font=ImageFont.load_default())
    img.save("temp.png")
